{
  "//": "Sample configuration for messages-app-mcp. Copy to messages-mcp.config.json and adjust as needed.",
  "transport": "stdio",
  "http": {
    "host": "127.0.0.1",
    "port": 3338,
    "enableSseFallback": true,
    "corsOrigins": ["http://localhost:3338"],
    "dnsRebindingProtection": true,
    "allowedHosts": ["127.0.0.1", "localhost"]
  },
  "logViewer": {
    "enabled": true,
    "autoOpen": true,
    "pollIntervalMs": 2000,
    "port": 3337
  },
  "codeExecWrappers": {
    "outputDir": "src/agents/messages/generated",
    "serverCommand": "node",
    "serverArgs": ["dist/index.js", "--stdio"],
    "env": {
      "MESSAGES_MCP_LOG_VIEWER": "0",
      "MESSAGES_MCP_LOG_VIEWER_AUTO_OPEN": "0"
    }
  }
}
